# ─────────────────────────────────────────────────────────────────────────────
# OpenShoot environment. Copy to `.env` and edit:   cp .env.example .env
#
# The defaults below run the WHOLE app with zero API keys (mock AI, payments,
# email and safety providers), in either of the two supported local setups:
#
#   A) `pnpm dev`            → embedded Postgres (PGlite, ./.data/pglite)
#                              + local disk storage (./.data/storage).
#                              First run: `pnpm install && pnpm run setup && pnpm dev`
#
#   B) `docker compose up`   → Postgres 16 + MinIO (S3) containers. docker-compose.yml
#                              overrides DATABASE_URL, STORAGE_DRIVER, S3_* and
#                              LOCAL_STORAGE_DIR for you, so this file works unchanged.
#
# Every variable is validated in src/lib/env.ts (`pnpm check-env` prints the result).
# Rules of thumb:
#   • REQUIRED means "required for that feature / in production", OPTIONAL has a default.
#   • Leave a value empty (KEY=) to use the default. Keys that are commented out must
#     stay commented out unless you set a real value (an empty value is invalid for them).
#   • NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time: rebuild
#     (or `docker compose build`) after changing them. Never put secrets in them.
#   • No inline comments after values: put comments on their own line.
#   • NODE_ENV is set by Next.js / the Docker image; don't set it here.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════ App ═════════════════════════════

# OPTIONAL. Product name shown in the UI, emails and page titles. Default: OpenShoot
NEXT_PUBLIC_APP_NAME=OpenShoot

# REQUIRED in production. Public base URL of the app, no trailing slash. Used for links in
# emails, auth callbacks and signed URLs. Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPTIONAL. Public base URL that AI/payment providers call back for webhooks. Defaults to
# NEXT_PUBLIC_APP_URL. While it points at localhost, webhooks are disabled and jobs complete by
# polling instead. In dev you can expose a tunnel (e.g. `cloudflared tunnel --url localhost:3000`)
# and put its https URL here.
WEBHOOK_BASE_URL=


# ═════════════════ Branding & legal (public, shown on legal pages) ═════════════════

# OPTIONAL. Contact address shown in the footer, FAQ and emails. Default: support@example.com
NEXT_PUBLIC_SUPPORT_EMAIL=
# OPTIONAL (set it in production). Where people report misuse of their likeness / request
# takedowns (acceptable-use policy + report button). Default: takedown@example.com
NEXT_PUBLIC_TAKEDOWN_EMAIL=
# OPTIONAL (set it in production). Legal name of the operator in the terms/privacy templates.
# Default: OpenShoot Operator
NEXT_PUBLIC_LEGAL_ENTITY=
# OPTIONAL. Governing-law jurisdiction in the terms template. Default: Delaware, USA
NEXT_PUBLIC_LEGAL_JURISDICTION=
# OPTIONAL. "Star on GitHub" / source link. Default: https://github.com/amankaushik481/openphotoai
NEXT_PUBLIC_GITHUB_URL=


# ═════════════════════ Analytics (PostHog) ═════════════════════
# Analytics are completely off unless a key is set.

# OPTIONAL. PostHog project API key (phc_…): https://app.posthog.com → Project settings.
NEXT_PUBLIC_POSTHOG_KEY=
# OPTIONAL. PostHog ingestion host. Default: https://us.i.posthog.com (EU: https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=


# ═════════════════════════════ Database ═════════════════════════════

# REQUIRED in production. Connection string:
#   • pglite:./.data/pglite      embedded Postgres in a local folder (default; dev only, single process)
#   • pglite:memory              throwaway in-memory database (tests)
#   • postgres://user:pass@host:5432/db   any Postgres 14+ (16 recommended): Docker, Neon, Supabase, RDS…
#     (Supabase/Neon poolers on :6543 / "-pooler" hosts are detected automatically)
# Docker Compose ignores this value and uses its bundled Postgres.
DATABASE_URL=pglite:./.data/pglite

# OPTIONAL. Max connections per server process (postgres:// only). Use 1–3 on serverless
# (Vercel) with a pooled URL. Default: 10 (keep it commented out unless you set a number)
# DATABASE_POOL_MAX=10


# ═════════════════════════════ Auth ═════════════════════════════

# REQUIRED in production. Long random string (32+ chars) that signs sessions, magic links and
# local-storage file URLs. Anyone who knows it can sign in as ANY user. Generate one with:
#   openssl rand -base64 32
# Production refuses to start with a value shorter than 32 characters, a published placeholder, or one with fewer
# than 8 distinct characters.
# When empty: `pnpm dev` uses a publicly known INSECURE dev value (fine on localhost only), and the
# Docker image generates a random secret on first start and keeps it in its data volume
# (/data/.auth-secret).
BETTER_AUTH_SECRET=

# OPTIONAL. "Continue with Google". Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials with the redirect URI
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
# Magic-link email sign-in always works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL. Comma-separated emails that are always admins (access to /admin).
ADMIN_EMAILS=

# OPTIONAL. `pnpm db:seed` / `pnpm run setup` (and the Docker entrypoint) create or promote this
# user to admin. Idempotent. SEED_ADMIN_NAME is the display name for a newly created user.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=


# ═════════════════════ Provider selection ═════════════════════

# LOCAL / DEMO ONLY. true = every provider defaults to its mock (no keys, no cost, deterministic
# fake results). Explicit *_PROVIDER values below still win. Default: false — set to true here so a
# fresh checkout works with zero keys.
#   ⚠️  With mock payments anyone can add credits for free, and with mock email every sign-in link is
#   PUBLICLY readable at /dev/emails (= anyone can sign in as anyone). That is fine on localhost or for
#   a throwaway demo, never for real users.
#   • Real deployment: set MOCK_PROVIDERS=false and configure the real providers below. In
#     production a real AI_PROVIDER requires real payments (stripe) AND real email (resend): the app
#     refuses to start with a mix.
#   • All-mock production (public demo, `docker compose up` defaults) is allowed; every page then
#     shows a "Demo mode — mock providers" banner.
MOCK_PROVIDERS=true

# OPTIONAL. Simulated provider latency for mock jobs, in ms. Default: 1500
MOCK_JOB_DELAY_MS=

# OPTIONAL. Image / training / video backend: mock | fal | replicate.
# Default: mock when MOCK_PROVIDERS=true, otherwise fal.
# AI_PROVIDER=fal

# OPTIONAL. Payments: mock | stripe. Default: mock when MOCK_PROVIDERS=true, otherwise stripe.
# PAYMENT_PROVIDER=stripe

# OPTIONAL. Email: mock | resend. Default: resend when RESEND_API_KEY is set and
# MOCK_PROVIDERS is not true, otherwise mock (mock emails are listed at /dev/emails; in production
# only when AI, payments and email are ALL mock and mock email was chosen explicitly, with
# MOCK_PROVIDERS=true or EMAIL_PROVIDER=mock).
# EMAIL_PROVIDER=resend


# ═════════════════════════════ AI providers ═════════════════════════════

# REQUIRED when AI_PROVIDER=fal. https://fal.ai/dashboard/keys
# (fal webhooks are verified with fal's public keys; no webhook secret needed.)
FAL_KEY=

# REQUIRED when AI_PROVIDER=replicate. https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# RECOMMENDED with Replicate: webhook signing secret (whsec_…). Get it once with
#   curl -s -H "Authorization: Bearer $REPLICATE_API_TOKEN" https://api.replicate.com/v1/webhooks/default/secret
REPLICATE_WEBHOOK_SECRET=
# REQUIRED when AI_PROVIDER=replicate. Replicate username or organization that will own the
# private models created by training (https://replicate.com/account).
REPLICATE_OWNER=


# ═══════════════════════ Safety (core module, always on) ═══════════════════════
# Face matching / age checks and content moderation run on EVERY training photo, prompt and
# output. "local" runs in-process models and needs no keys. With a real AI_PROVIDER these can
# never be "mock" — src/lib/env.ts refuses to start. See docs/SAFETY.md.

# OPTIONAL. mock | local | rekognition. Default: mock with mock AI, otherwise local.
# FACE_PROVIDER=local

# OPTIONAL. mock | local | openai. Default: mock with mock AI, otherwise local.
# MODERATION_PROVIDER=local

# REQUIRED when MODERATION_PROVIDER=openai (omni-moderation). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# REQUIRED when FACE_PROVIDER=rekognition. IAM user/role allowed to call Amazon Rekognition
# (DetectFaces, CompareFaces): https://console.aws.amazon.com/iam/
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ═════════════════════════════ Storage ═════════════════════════════
# Photos, training sets and videos. Users only ever get short-lived signed URLs.

# OPTIONAL. local | s3. Default: local.
#   local → files on disk, served by /api/files with signed tokens (single server / dev).
#   s3    → any S3-compatible bucket: Cloudflare R2, AWS S3, MinIO, Backblaze B2…
# Docker Compose ignores this and uses its bundled MinIO (s3).
STORAGE_DRIVER=local

# OPTIONAL (local driver). Directory for stored files. Default: ./.data/storage
LOCAL_STORAGE_DIR=./.data/storage

# REQUIRED for s3 (except AWS S3, where it is omitted). Endpoint that BOTH the server and
# users' browsers can reach (signed URLs point at it).
#   Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   (create an API token: Cloudflare dashboard → R2 → Manage R2 API Tokens → Object Read & Write)
S3_ENDPOINT=
# OPTIONAL. Bucket region; "auto" for R2, e.g. us-east-1 for AWS. Default: auto
S3_REGION=auto
# REQUIRED for s3. Private bucket name (never make it public).
S3_BUCKET=
# REQUIRED for s3. Access key pair with read/write/delete on the bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# OPTIONAL. Path-style URLs (endpoint/bucket/key); needed for MinIO. Default: false
S3_FORCE_PATH_STYLE=


# ═════════════════════════════ Payments (Stripe) ═════════════════════════════
# Checkout uses inline prices from src/config/plans.ts: no products to create in Stripe.

# REQUIRED when PAYMENT_PROVIDER=stripe. Secret key (sk_live_… / sk_test_…):
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# REQUIRED when PAYMENT_PROVIDER=stripe. Signing secret (whsec_…) of a webhook endpoint at
#   <WEBHOOK_BASE_URL>/api/webhooks/payments/stripe   (https://dashboard.stripe.com/webhooks)
# subscribed to these events:
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   customer.subscription.created, customer.subscription.updated, customer.subscription.deleted,
#   invoice.paid, invoice.payment_failed, charge.refunded,
#   charge.dispute.created, charge.dispute.closed   (chargebacks: credits are frozen, the account flagged)
# If you enable the Customer Portal, turn off "customers can switch plans" (and pausing): plan
# changes happen through a new checkout in the app.
# Locally: stripe listen --forward-to localhost:3000/api/webhooks/payments/stripe
STRIPE_WEBHOOK_SECRET=
# OPTIONAL. Show the promotion-code box at checkout. Stripe accepts EVERY active promotion code in
# the account there (also ones made for other products), so restrict your codes before enabling.
# Default: false
# STRIPE_ALLOW_PROMOTION_CODES=true
# OPTIONAL. Pin existing Stripe Price ids instead of inline prices (src/config/plans.ts amounts are
# then ignored for that item):
#   STRIPE_PRICE_<PLAN>_<MONTH|YEAR>  with PLAN = STARTER | PRO | STUDIO
#   STRIPE_PRICE_<PACKID>             with PACKID = CREDITS_100 | CREDITS_500 | CREDITS_1500
# STRIPE_PRICE_STARTER_MONTH=price_...
# STRIPE_PRICE_STARTER_YEAR=price_...
# STRIPE_PRICE_PRO_MONTH=price_...
# STRIPE_PRICE_PRO_YEAR=price_...
# STRIPE_PRICE_STUDIO_MONTH=price_...
# STRIPE_PRICE_STUDIO_YEAR=price_...
# STRIPE_PRICE_CREDITS_100=price_...
# STRIPE_PRICE_CREDITS_500=price_...
# STRIPE_PRICE_CREDITS_1500=price_...


# ═════════════════════════════ Email (Resend) ═════════════════════════════

# REQUIRED for real email (magic links!) in production. https://resend.com/api-keys
RESEND_API_KEY=
# OPTIONAL. Sender; must be on a domain verified at https://resend.com/domains.
# Default: OpenShoot <hello@localhost>
EMAIL_FROM="OpenShoot <hello@localhost>"


# ═════════════════════════════ Operations ═════════════════════════════

# REQUIRED to enable /api/cron/jobs and /api/cron/maintenance (requests must send
# `Authorization: Bearer <CRON_SECRET>`; without a secret the endpoints refuse every call).
# Generate with `openssl rand -hex 32`. Vercel Cron sends this header automatically.
# Note: Vercel's Hobby plan only allows DAILY crons — change the /api/cron/jobs schedule in
# vercel.json to daily (e.g. "0 0 * * *") there. Jobs still finish via webhooks and the lazy sync
# on GET /api/jobs/:id. Docker runs `pnpm worker` (the "worker" service) instead of cron.
CRON_SECRET=

# OPTIONAL (`pnpm worker` / Docker worker). Poll interval in ms, max jobs synced per pass, and how
# often the worker runs maintenance (same as /api/cron/maintenance; 0 = never).
# Defaults: 5000, 50 and 3600000 (hourly).
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_BATCH_LIMIT=50
# WORKER_MAINTENANCE_INTERVAL_MS=3600000

# OPTIONAL. Free credits granted to every new account. Default: 0
SIGNUP_BONUS_CREDITS=

# OPTIONAL. Visible watermark on outputs of free users who never paid. Default: true
WATERMARK_FREE_TIER=

# OPTIONAL. Public demo: enables /api/demo/login and the "Try the demo" button.
# Requires mock AI + mock payments. Default: false
DEMO_MODE=false

# OPTIONAL. How many reverse proxies in front of the app append to X-Forwarded-For (nginx with
# $proxy_add_x_forwarded_for, Caddy, Traefik, a cloud load balancer…). The client IP used for per-IP
# rate limits and consent records is the Nth address from the RIGHT of X-Forwarded-For, so addresses
# a client adds itself are ignored. Typical values:
#   0  nothing in front (`pnpm dev`, local Docker): forwarded headers are ignored, IP is "unknown"
#   1  one proxy (nginx/Caddy/Traefik in front of Docker), or Vercel
#   2  a CDN (e.g. Cloudflare) in front of your proxy
# Too high lets clients spoof their IP; too low makes clients share a proxy's address. Allowed: 0–10.
# Default: 1 on Vercel (VERCEL is set), otherwise 0. Keep it commented out unless you set a number.
# TRUSTED_PROXY_HOPS=1


# ═════════════════════════════ Build ═════════════════════════════

# OPTIONAL. Set to "standalone" to emit .next/standalone (the Dockerfile sets it for you).
# Leave empty for `pnpm build` / Vercel.
NEXT_OUTPUT=

# OPTIONAL (build time). Production builds leave the embedded PGlite database out of the deployment;
# set to true when building if you really want DATABASE_URL=pglite:… in production. Default: off
# OPENSHOOT_TRACE_PGLITE=true


# ═══════════════════ Docker Compose only (docker-compose.yml) ═══════════════════
# Uncomment to change the bundled services. Passwords must be URL-safe (letters/digits).
# POSTGRES_PASSWORD=openshoot
# MINIO_ROOT_USER=openshoot
# MINIO_ROOT_PASSWORD=openshoot-dev-secret
# Host port for MinIO's S3 API (the browser loads signed URLs from http://localhost:<port>).
# MINIO_PORT=9000
#
# Container entrypoint knobs (docker/entrypoint.sh), all optional:
#   MIGRATE_ON_START  run migrations before starting. Default: true for web, false for worker
#   SEED_ON_START     run the idempotent seed after migrating. Default: same as MIGRATE_ON_START
#   DB_WAIT_TIMEOUT   seconds to wait for Postgres. Default: 60
#   AUTH_SECRET_FILE  where the generated BETTER_AUTH_SECRET is kept when none is set.
#                     Default: /data/.auth-secret (the app-data volume, shared by web + worker)
# AUTH_SECRET_FILE=/data/.auth-secret


# ═══════════════════ End-to-end tests (playwright.config.ts) ═══════════════════
# OPTIONAL. Postgres database used (and recreated!) by `pnpm test:e2e`. Its name must contain
# "e2e" or "test". Default: postgres://openshoot:openshoot@localhost:5432/openshoot_e2e
# E2E_DATABASE_URL=postgres://openshoot:openshoot@localhost:5432/openshoot_e2e
# OPTIONAL. Local-disk storage directory used by the e2e server. Default: ./.data/e2e-storage
# E2E_STORAGE_DIR=./.data/e2e-storage
