{
  "name": "openshoot",
  "version": "0.1.0",
  "private": true,
  "description": "OpenShoot \u2014 open-source, self-hostable AI photographer. Train your identity model, generate photos from packs, edit, upscale, make videos.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --import ./scripts/preload/server-only.mjs scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --import ./scripts/preload/server-only.mjs scripts/seed.ts",
    "setup": "tsx --import ./scripts/preload/server-only.mjs scripts/setup.ts",
    "bootstrap": "tsx --import ./scripts/preload/server-only.mjs scripts/setup.ts",
    "worker": "tsx --import ./scripts/preload/server-only.mjs scripts/worker.ts",
    "check-env": "tsx --import ./scripts/preload/server-only.mjs scripts/check-env.ts",
    "packs:validate": "tsx --import ./scripts/preload/server-only.mjs scripts/validate-packs.ts",
    "email:dev": "email dev --dir src/emails --port 3010",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1176.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@electric-sql/pglite": "^0.6.0",
    "@fal-ai/client": "*",
    "@react-email/components": "*",
    "@react-email/render": "*",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@vladmandic/human": "3.3.6",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "*",
    "nanoid": "^5.1.5",
    "next": "16.4.6",
    "next-themes": "*",
    "nsfwjs": "4.4.0",
    "postgres": "^3.4.7",
    "posthog-js": "*",
    "radix-ui": "*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "replicate": "*",
    "resend": "*",
    "server-only": "^0.0.1",
    "sharp": "*",
    "sonner": "*",
    "stripe": "^23.2.0",
    "swr": "*",
    "tailwind-merge": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.8.1",
    "react-email": "*",
    "tailwindcss": "4.3.3",
    "tsx": "*",
    "tw-animate-css": "*",
    "typescript": "^5",
    "vite-tsconfig-paths": "*",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.28.0"
}
